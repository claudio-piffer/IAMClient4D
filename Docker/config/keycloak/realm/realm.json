{
  "realm": "iamclient4d",
  "displayName": "IAMClient4D samples",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "api-server": [
        {
          "name": "calculator-user",
          "description": "Scientific calculator sample: elementary math, trigonometry, number theory"
        },
        {
          "name": "calculator-advanced",
          "description": "Scientific calculator sample: statistics and equations"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "iam4d-sample-app",
      "name": "IAMClient4D desktop and mobile samples",
      "description": "VCL KeycloakClient, VCL and FMX IdentityBrokering: loopback redirect on any port (RFC 8252) and the private-use scheme of the mobile app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/oauth2callback",
        "http://127.0.0.1/oauth2callback",
        "it.iam4d.identitybrokering:/oauth2callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email", "kc-admin-api"],
      "protocolMappers": [
        {
          "name": "api-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "iam4d-sample-unigui",
      "name": "IAMClient4D uniGUI sample",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:8077",
      "redirectUris": ["http://localhost:8077/?oauthcallback=keycloak", "http://localhost:8077/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "iam4d-sample-service",
      "name": "IAMClient4D samples (client credentials)",
      "description": "Sample only: the secret is public, never reuse it outside this local Keycloak",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "iam4d-test-only-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api-server",
      "name": "Scientific calculator API",
      "description": "Audience of the DMVC samples and owner of their client roles: no flow, never signs in",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "calculator-web",
      "name": "Scientific Calculator web client",
      "description": "DMVC + HTMX web client of the ScientificCalculator samples. Sample only: the secret is public, never reuse it outside this local Keycloak",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "calculator-web-test-only-secret",
      "rootUrl": "http://localhost:8092",
      "baseUrl": "/",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8092/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8092/"
      },
      "protocolMappers": [
        {
          "name": "api-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@iamclient4d.example",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "clientRoles": { "realm-management": ["realm-admin"] }
    },
    {
      "username": "student",
      "enabled": true,
      "email": "student@iamclient4d.example",
      "emailVerified": true,
      "firstName": "Stu",
      "lastName": "Dent",
      "credentials": [{ "type": "password", "value": "Student#2026", "temporary": false }],
      "clientRoles": { "api-server": ["calculator-user"] }
    },
    {
      "username": "scientist",
      "enabled": true,
      "email": "scientist@iamclient4d.example",
      "emailVerified": true,
      "firstName": "Marie",
      "lastName": "Curie",
      "credentials": [{ "type": "password", "value": "Scientist#2026", "temporary": false }],
      "clientRoles": { "api-server": ["calculator-user", "calculator-advanced"] }
    },
    {
      "username": "service-account-iam4d-sample-service",
      "enabled": true,
      "serviceAccountClientId": "iam4d-sample-service",
      "clientRoles": { "api-server": ["calculator-user"] }
    }
  ],
  "identityProviders": [
    {
      "alias": "spid-test",
      "displayName": "SPID test (spid-saml-check)",
      "providerId": "spid-saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "FORCE",
        "idpEntityId": "http://localhost:${SPID_CHECK_PORT:18443}/demo",
        "singleSignOnServiceUrl": "http://localhost:${SPID_CHECK_PORT:18443}/demo/samlsso",
        "singleLogoutServiceUrl": "http://localhost:${SPID_CHECK_PORT:18443}/demo/samlsso",
        "principalType": "ATTRIBUTE",
        "principalAttribute": "fiscalNumber",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:transient",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "validateSignature": "true",
        "signSpMetadata": "true",
        "forceAuthn": "true",
        "postBindingAuthnRequest": "true",
        "postBindingResponse": "true",
        "postBindingLogout": "true",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "NONE",
        "attributeConsumingServiceIndex": "1",
        "attributeConsumingServiceName": "it|Servizio di esempio",
        "authnContextClassRefs": "[\"https://www.spid.gov.it/SpidL2\"]",
        "authnContextComparisonType": "minimum",
        "organizationNames": "it|Comune di Esempio",
        "organizationDisplayNames": "it|Comune di Esempio",
        "organizationUrls": "it|https://www.comune.esempio.it",
        "otherContactIsSpPrivate": "false",
        "otherContactIpaCode": "c_x000",
        "otherContactEmail": "protocollo@comune.esempio.it",
        "otherContactPhone": "+390123456789"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "fiscalNumber",
      "identityProviderAlias": "spid-test",
      "identityProviderMapper": "spid-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "fiscalNumber", "user.attribute": "fiscalNumber" }
    },
    {
      "name": "email",
      "identityProviderAlias": "spid-test",
      "identityProviderMapper": "spid-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "email", "user.attribute": "email" }
    },
    {
      "name": "name",
      "identityProviderAlias": "spid-test",
      "identityProviderMapper": "spid-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "name", "user.attribute": "firstName" }
    },
    {
      "name": "familyName",
      "identityProviderAlias": "spid-test",
      "identityProviderMapper": "spid-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "familyName", "user.attribute": "lastName" }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"fiscalNumber\",\"displayName\":\"Codice fiscale\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
