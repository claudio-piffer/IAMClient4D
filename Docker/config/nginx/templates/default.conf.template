server {
	listen $GATEWAY_PORT ssl;
	http2 on;

	server_name $DOMAIN_NAME;

	ssl_certificate     /etc/nginx/ssl/certs/certificate.crt;
	ssl_certificate_key /etc/nginx/ssl/certs/private.key;

	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 10m;

	add_header X-Content-Type-Options nosniff always;
	add_header Referrer-Policy "no-referrer" always;

	client_max_body_size 10M;
	proxy_buffers 16 16k;
	proxy_buffer_size 32k;

	# Keycloak (its pages set their own Content-Security-Policy)
	location /auth/ {
		proxy_pass http://keycloak:8080/auth/;
		include /etc/nginx/includes/proxy-headers.conf;
	}

	location / {
		return 404;
	}
}
