# Optional settings of the sample environment: copy this file to .env (next to
# docker-compose.yml) and uncomment what you change. Without .env the defaults below apply.
# Passwords are not here: setup-secrets generates them in secrets/.

# Host port of Keycloak (http://localhost:KC_PORT/auth, bound to 127.0.0.1)
#KC_PORT=18180

# Keycloak admin user (password: secrets/kc_admin_password.txt)
#IAM_ADMIN_USER=admin

# Versions: Keycloak and the SPID / CIE extensions must have the same minor
# (SPID_SHA256 and CIE_SHA256 in the environment when SPID_VERSION or CIE_VERSION change)
#KC_VERSION=26.8.2
#SPID_VERSION=26.8.1
#CIE_VERSION=26.8.1
#SPID_CHECK_VERSION=2.2.5

# Profile brokering: host ports of the SPID demo identity provider and of the CIE simulator
#SPID_CHECK_PORT=18443
#CIE_CHECK_PORT=18444

# Profile tls: name or IP address the browser and the samples use (the certificate is made for
# it), and the HTTPS port, published on every interface. Keycloak: https://DOMAIN_NAME:GATEWAY_PORT/auth
#DOMAIN_NAME=192.168.1.100
#GATEWAY_PORT=24443
